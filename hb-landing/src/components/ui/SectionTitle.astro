---
interface Props {
  number: string;
  title: string;
  class?: string;
}

const { number, title, class: className = '' } = Astro.props;
---

<div class={`mb-12 ${className}`}>
  <div class="text-muted-foreground font-medium mb-2 text-sm tracking-wide">
    {number}
  </div>
  <h2 class="text-4xl md:text-5xl font-bold font-heading text-foreground max-w-3xl">
    {title}
  </h2>
</div>
