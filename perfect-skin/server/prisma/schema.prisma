// Perfect Skin — схема БД.
//
// ВАЖНО: это ОТДЕЛЬНАЯ база от магазина Симба. Своя переменная окружения
// (PS_DATABASE_URL, не DATABASE_URL) и свой сгенерированный клиент — чтобы
// миграция этого проекта физически не могла задеть работающий магазин кормов.
// Обоснование разделения — docs/decisions/2026-07-perfect-skin-architecture.md

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/ps-client"
}

datasource db {
  provider = "postgresql"
  url      = env("PS_DATABASE_URL")
}

// ─────────────────────────────── Перечисления ───────────────────────────────

/// Роли сотрудников и покупателей. Роли «профессионал» здесь НЕТ:
/// профи-доступ определяется ProProfile.status, см. комментарий у модели.
enum UserRole {
  super_admin
  orders_manager
  products_manager
  content_manager
  customer
}

enum OtpChannel {
  email
  sms
}

/// Жизненный цикл заявки косметолога.
enum ProStatus {
  draft // заявка создана, документы догружаются
  pending // отправлена, ждёт проверки
  approved // одобрена — профи-цены открыты
  rejected // отклонена с причиной, можно подать заново
  revoked // доступ отозван после одобрения
}

enum SkinType {
  normal
  dry
  oily
  combination
  sensitive
  mature
}

/// Задача, которую решает средство.
enum Concern {
  hydration
  anti_age
  pigmentation
  acne
  sensitivity
  redness
  cleansing
  sun_protection
  firming
  eye_area
  post_procedure
}

/// Единица фасовки: мл для флаконов, г для банок, шт для наборов.
enum VolumeUnit {
  ml
  g
  pcs
}

/// Какой прайс применён. Хранится в заказе снапшотом.
enum PriceTier {
  retail
  pro
}

enum FilterType {
  checkbox
  range
  select
}

enum OrderStatus {
  new
  confirmed
  packed
  in_transit
  delivered
  cancelled
}

/// Пункт выдачи и курьер разделены: у них разные пороги бесплатной доставки
/// (6 000 ₽ и 10 000 ₽).
enum DeliveryMethod {
  cdek_pvz
  cdek_courier
  pickup
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

/// Кому виден материал Бьюти-клуба или Pro-кабинета.
enum Audience {
  public
  retail
  pro
}

enum BannerPage {
  home
  catalog
  brand
  club
  other
}

enum BannerPosition {
  main_slider
  promo_strip
  sidebar
}

enum ConsultationStatus {
  new
  contacted
  scheduled
  done
  cancelled
}

// ──────────────────────── Пользователи и доступ ────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String?
  phone           String?
  name            String
  passwordHash    String? // только сотрудники
  role            UserRole  @default(customer)
  isActive        Boolean   @default(true)
  acceptedTermsAt DateTime? // согласие на обработку ПДн — храним документы

  /// Версия сессий. Сверяется при каждом запросе: увеличение мгновенно
  /// обесценивает все выданные токены. Без этого понижение роли или блокировка
  /// сотрудника вступали бы в силу только через 7 дней — срок жизни JWT.
  tokenVersion Int @default(0)

  /// Троттлинг входа считается на ПОЛЬЗОВАТЕЛЯ, а не на код: иначе перебор
  /// обходится запросом нового кода — счётчик попыток обнулялся бы вместе с ним.
  otpFailedCount  Int       @default(0)
  otpBlockedUntil DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  addresses        Address[]
  orders           Order[]
  cart             Cart?
  otpCodes         OtpCode[]
  favorites        Favorite[]
  proProfile       ProProfile?
  ownedPromoCodes  PromoCode[]            @relation("PromoOwner")
  promoRedemptions PromoCodeRedemption[]
  offerAssignments OfferAssignment[]
  skinSurveys      SkinSurvey[]
  reviewedProfiles ProProfile[]           @relation("ProReviewer")
  editedProPrices  VariantProPrice[]      @relation("ProPriceEditor")
  consultations    ConsultationRequest[]
  proStatusActions ProProfileStatusLog[]  @relation("ProStatusActor")
  docAccessActions ProDocumentAccessLog[] @relation("DocAccessActor")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

/// Одноразовые коды входа.
/// Отличия от Симбы намеренные: там код лежит открытым, а счётчик попыток живёт
/// в памяти процесса — при рестарте или втором инстансе защита от перебора
/// обнуляется. Здесь хеш и счётчик в БД.
///
/// codeHash — ТОЛЬКО bcrypt или argon2 с солью. Быстрый хеш (sha256) здесь
/// бесполезен: у шестизначного кода миллион вариантов, дамп таблицы
/// перебирается за секунды, и хеширование не даёт ничего.
model OtpCode {
  id        String     @id @default(uuid())
  userId    String
  codeHash  String
  channel   OtpChannel
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("otp_codes")
}

model Address {
  id         String    @id @default(uuid())
  userId     String
  label      String
  city       String
  street     String
  house      String
  apartment  String?
  postalCode String
  isDefault  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

/// Заявка косметолога. ЕДИНСТВЕННЫЙ источник истины о праве видеть профи-цены —
/// поле status, проверяемое по БД в момент запроса.
///
/// Почему не роль и не claim в токене: JWT живёт 7 дней, поэтому отозванный
/// доступ работал бы ещё неделю. Плюс у статуса есть срок (approvedUntil),
/// а у роли срока не бывает.
model ProProfile {
  id     String    @id @default(uuid())
  userId String    @unique
  status ProStatus @default(draft)

  companyName    String?
  legalForm      String? // ИП / ООО / самозанятый / физлицо-специалист
  inn            String?
  ogrn           String?
  specialization String?
  clinicAddress  String?
  contactPhone   String?
  website        String?

  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  approvedUntil   DateTime? // null = бессрочно
  revokedAt       DateTime?
  revokedById     String?
  revokeReason    String?
  adminNote       String? // наружу не отдаётся никогда

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?                 @relation("ProReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents  ProDocument[]
  promoCodes PromoCode[]
  statusLogs ProProfileStatusLog[]

  @@index([status])
  @@index([submittedAt])
  @@index([approvedUntil])
  @@map("pro_profiles")
}

/// Документы косметолога. Бакет приватный: публичного URL не существует,
/// наружу отдаётся только presigned-ссылка с коротким сроком жизни.
/// Имя объекта генерирует сервер — пользовательское имя файла хранится
/// отдельно, иначе открывается path traversal.
model ProDocument {
  id           String    @id @default(uuid())
  proProfileId String
  objectKey    String    @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  docType      String? // diploma | certificate | company_docs | other
  uploadedAt   DateTime  @default(now())
  deletedAt    DateTime?

  proProfile ProProfile             @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  accessLogs ProDocumentAccessLog[]

  @@index([proProfileId])
  @@map("pro_documents")
}

/// История смены статуса заявки. Без неё цикл «одобрили → отозвали → одобрили»
/// затирает предыдущие значения, и на вопрос «кто и на каком основании вернул
/// доступ в марте» ответить нечем.
model ProProfileStatusLog {
  id           String     @id @default(uuid())
  proProfileId String
  fromStatus   ProStatus?
  toStatus     ProStatus
  actorId      String?
  reason       String?
  ip           String?
  createdAt    DateTime   @default(now())

  proProfile ProProfile @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  actor      User?      @relation("ProStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([proProfileId, createdAt])
  @@index([actorId])
  @@map("pro_profile_status_logs")
}

/// Журнал доступа к документам косметологов. Ссылка на 5 минут защищает от
/// публичного доступа, но не отвечает, какой сотрудник выгрузил дипломы всех
/// партнёров. Запись делается в момент ВЫДАЧИ ссылки.
model ProDocumentAccessLog {
  id         String   @id @default(uuid())
  documentId String
  actorId    String?
  action     String // view | download
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  document ProDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor    User?       @relation("DocAccessActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([actorId, createdAt])
  @@map("pro_document_access_logs")
}

// ─────────────────────────────── Каталог ───────────────────────────────

model Category {
  id             String    @id @default(uuid())
  name           String
  slug           String
  description    String?
  image          String?
  parentId       String?
  seoTitle       String?
  seoDescription String?
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]
  filters  CategoryFilter[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive, deletedAt])
  @@map("categories")
}

/// ISSEIMI и GLACÉE Skincare. Написание строго как в дизайн-системе.
model Brand {
  id             String    @id @default(uuid())
  name           String
  slug           String
  logo           String?
  description    String?
  country        String?   @default("Испания")
  manufacturer   String?   @default("Heber Farma")
  seoTitle       String?
  seoDescription String?
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  lines    ProductLine[]
  products Product[]

  @@index([slug])
  @@map("brands")
}

/// Линейка внутри бренда: ISSEIMI Base, ISSEIMI MD, ISSEIMI Nat Collection,
/// GLACÉE Skincare Man Line. Модель, а не перечисление: новая линейка не должна
/// требовать миграции.
model ProductLine {
  id             String    @id @default(uuid())
  brandId        String
  name           String
  slug           String
  description    String?
  image          String?
  isProfessional Boolean   @default(false) // ISSEIMI MD — для кабинета
  seoTitle       String?
  seoDescription String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([brandId, name])
  @@index([brandId])
  @@index([slug])
  @@map("product_lines")
}

/// Активный компонент. Отдельная модель, потому что это и фильтр каталога,
/// и точка входа из поиска («средства с ретинолом»).
model Ingredient {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductIngredient[]

  @@map("ingredients")
}

/// Товар. Зоо-полей Симбы (белки, жиры, беззерновой корм) здесь нет —
/// вместо них характеристики косметики.
model Product {
  id                 String     @id @default(uuid())
  name               String
  slug               String
  shortDescription   String?
  description        String
  brandId            String?
  lineId             String?
  images             String[]
  skinTypes          SkinType[]
  concerns           Concern[]
  usage              String?
  inciText           String? // полный состав как на этикетке
  isProfessionalOnly Boolean    @default(false)
  seoTitle           String?
  seoDescription     String?
  isActive           Boolean    @default(true)
  isFeatured         Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  brand        Brand?               @relation(fields: [brandId], references: [id], onDelete: Restrict)
  line         ProductLine?         @relation(fields: [lineId], references: [id], onDelete: SetNull)
  categories   ProductCategory[]
  variants     ProductVariant[]
  ingredients  ProductIngredient[]
  filterValues ProductFilterValue[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  favorites    Favorite[]

  @@index([slug])
  @@index([brandId])
  @@index([lineId])
  @@index([isActive, deletedAt])
  @@index([isProfessionalOnly])
  @@index([createdAt])
  @@map("products")
}

/// Фасовка товара. У Симбы здесь вес корма в килограммах — для косметики это
/// вводит в заблуждение, поэтому объём с явной единицей измерения.
///
/// Розничная цена живёт здесь. Профессиональная — в отдельной таблице, см.
/// VariantProPrice: это защита от утечки, а не нормализация ради красоты.
model ProductVariant {
  id             String     @id @default(uuid())
  productId      String
  volumeValue    Decimal    @db.Decimal(7, 2)
  volumeUnit     VolumeUnit @default(ml)
  volumeLabel    String? // «набор из 3 средств» — переопределяет вывод
  retailPrice    Int // копейки: 807700 = 8 077 ₽
  oldRetailPrice Int?
  stock          Int        @default(0)
  sku            String?    @unique
  barcode        String?
  externalId     String?    @unique // id в старом WooCommerce для импорта
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  proPrice   VariantProPrice?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([isActive, deletedAt])
  @@index([retailPrice])
  @@map("product_variants")
}

/// Профессиональный прайс — ОТДЕЛЬНАЯ таблица сознательно.
///
/// Если бы поле лежало рядом с retailPrice, любой из десятков вызовов
/// `include: { variants: true }` отдал бы оптовую цену наружу. Защита «не забыть
/// исключить поле» требует правильного действия в каждой точке кода; здесь же
/// чтобы цена попала в ответ, разработчик обязан НАПИСАТЬ `proPrice: true`.
/// Утечка становится действием, а не забывчивостью.
model VariantProPrice {
  variantId   String   @id
  price       Int
  minQty      Int      @default(1) // минимальная партия
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  updatedBy User?          @relation("ProPriceEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt])
  @@index([updatedById])
  @@map("variant_pro_prices")
}

model ProductCategory {
  productId  String
  categoryId String
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductIngredient {
  productId     String
  ingredientId  String
  concentration String? // «2%», «10 000 Da» — единицы разные, поэтому строка
  isKey         Boolean @default(false)
  sortOrder     Int     @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
  @@index([ingredientId])
  @@map("product_ingredients")
}

/// Фильтры, которыми управляет админ. Тип кожи и назначение сюда НЕ дублировать —
/// они уже типизированные поля товара, фасеты для них строятся из перечислений.
model Filter {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  type      FilterType
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  values     FilterValue[]
  categories CategoryFilter[]

  @@map("filters")
}

model FilterValue {
  id        String   @id @default(uuid())
  filterId  String
  value     String
  slug      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  filter   Filter               @relation(fields: [filterId], references: [id], onDelete: Cascade)
  products ProductFilterValue[]

  @@unique([filterId, slug])
  @@index([filterId])
  @@map("filter_values")
}

model ProductFilterValue {
  productId     String
  filterValueId String

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  filterValue FilterValue @relation(fields: [filterValueId], references: [id], onDelete: Cascade)

  @@id([productId, filterValueId])
  @@index([filterValueId])
  @@map("product_filter_values")
}

model CategoryFilter {
  categoryId String
  filterId   String
  sortOrder  Int    @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  filter   Filter   @relation(fields: [filterId], references: [id], onDelete: Cascade)

  @@id([categoryId, filterId])
  @@map("category_filters")
}

// ──────────────────────────── Корзина и заказы ────────────────────────────

/// Гость собирает корзину по sessionId, при входе она сливается с пользовательской.
model Cart {
  id        String   @id @default(uuid())
  userId    String?  @unique
  sessionId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([updatedAt])
  @@map("carts")
}

/// Цену в корзине НЕ храним: она вычисляется при чтении по прайсу текущего
/// пользователя. Иначе профессиональная цена «залипнет» в корзине после того,
/// как доступ отозвали.
model CartItem {
  id               String   @id @default(uuid())
  cartId           String
  productVariantId String
  productId        String
  quantity         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productVariantId])
  @@index([cartId])
  @@index([productId])
  @@index([productVariantId])
  @@map("cart_items")
}

model Order {
  id     String      @id @default(uuid())
  number String      @unique // PS-000123
  userId String
  status OrderStatus @default(new)

  /// Снапшот прайса: заказ навсегда помнит, по какому прайсу он оформлен.
  priceTier PriceTier

  deliveryMethod      DeliveryMethod
  deliveryAddress     Json?
  cdekPvzCode         String?
  deliveryCost        Int            @default(0)
  deliveryTrackNumber String?

  recipientName  String
  recipientPhone String
  recipientEmail String?

  subtotal Int

  /// ИНВАРИАНТ: при priceTier = pro промокода быть не может. Профи-цена уже
  /// оптовая, скидка сверху — это работа в минус либо схема, где косметолог
  /// покупает по собственному коду. Продублировано CHECK-ограничением в
  /// sql/01-constraints.sql, чтобы правило не держалось на одном коде.
  promoCodeId    String?
  promoCodeValue String? // снапшот строки кода
  promoPercent   Int? // снапшот процента на момент заказа
  promoDiscount  Int     @default(0)
  total          Int

  paymentStatus PaymentStatus @default(pending)
  paymentId     String?
  paidAt        DateTime?

  comment   String?
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  promoCode  PromoCode?           @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  redemption PromoCodeRedemption?

  @@index([userId, createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([promoCodeId])
  @@map("orders")
}

/// Снапшот позиции: цена и прайс фиксируются на строке, чтобы возврат считался
/// по той цене, которая была уплачена, а не по текущей.
model OrderItem {
  id               String    @id @default(uuid())
  orderId          String
  productVariantId String
  productId        String
  productName      String
  brandName        String?
  volumeLabel      String // «50 мл», уже отформатировано
  price            Int
  priceTier        PriceTier
  quantity         Int
  createdAt        DateTime  @default(now())

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
  @@map("order_items")
}

model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("favorites")
}

// ─────────────────────────────── Промокоды ───────────────────────────────

/// Промокод косметолога. У Симбы код захардкожен строкой в расчёте итогов —
/// поэтому там нельзя ни выключить код, ни собрать статистику, ни завести второй
/// без выкладки. Здесь это данные.
model PromoCode {
  id             String    @id @default(uuid())
  code           String // хранится в верхнем регистре; уникальность частичным индексом
  ownerId        String?
  proProfileId   String?
  description    String?
  percent        Int       @default(15) // утверждено заказчиком
  maxRedemptions Int? // null = без лимита
  usedCount      Int       @default(0)
  perUserLimit   Boolean   @default(false)
  minOrderAmount Int? // копейки
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  owner       User?                 @relation("PromoOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  proProfile  ProProfile?           @relation(fields: [proProfileId], references: [id], onDelete: SetNull)
  redemptions PromoCodeRedemption[]
  orders      Order[]
  offers      Offer[]

  @@index([ownerId])
  @@index([isActive, expiresAt])
  @@index([proProfileId])
  @@map("promo_codes")
}

/// Факт применения кода.
///
/// orderId уникален — повторная отправка того же заказа не засчитается дважды.
/// Пара (promoCodeId, perUserKey) уникальна: при лимите «один раз на пациента»
/// в perUserKey пишется userId, и вторая параллельная попытка падает на
/// ограничении БД. Когда лимита нет, туда пишется NULL, а Postgres считает
/// NULL-ы различными — то же ограничение просто молчит.
model PromoCodeRedemption {
  id          String @id @default(uuid())
  promoCodeId String
  orderId     String @unique
  userId      String

  /// HMAC от userId с серверным секретом, а НЕ сам идентификатор: строка
  /// участвует в уникальном ограничении и не должна раскрывать пациента.
  perUserKey     String?
  discountAmount Int
  orderSubtotal  Int
  createdAt      DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([promoCodeId, orderId])
  @@unique([promoCodeId, perUserKey])
  @@index([promoCodeId, createdAt])
  @@index([userId])
  @@map("promo_code_redemptions")
}

// ─────────────────────────────── Контент ───────────────────────────────

/// Публикация Бьюти-клуба или Pro-кабинета. Кто её видит, решает audience —
/// отдельных «клубных» таблиц заводить не нужно.
model Post {
  id             String    @id @default(uuid())
  slug           String
  title          String
  excerpt        String?
  body           String
  coverImage     String?
  audience       Audience  @default(public)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([audience, publishedAt])
  @@index([slug])
  @@map("posts")
}

/// Предложение. Без назначений — видно всей аудитории, с назначениями — только
/// перечисленным пользователям.
model Offer {
  id          String    @id @default(uuid())
  title       String
  description String?
  image       String?
  audience    Audience  @default(retail)
  promoCodeId String?
  linkUrl     String?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  promoCode   PromoCode?        @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  assignments OfferAssignment[]

  @@index([audience, isActive, endsAt])
  @@index([promoCodeId])
  @@map("offers")
}

model OfferAssignment {
  offerId   String
  userId    String
  seenAt    DateTime?
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([offerId, userId])
  @@index([userId])
  @@map("offer_assignments")
}

model Banner {
  id          String         @id @default(uuid())
  title       String
  image       String
  imageMobile String?
  link        String?
  alt         String // обязателен: требование доступности
  page        BannerPage
  position    BannerPosition
  audience    Audience       @default(public)
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([page, position, isActive])
  @@map("banners")
}

/// Подбор косметики — плашка на главной. Может быть анонимным.
///
/// ВНИМАНИЕ: isPregnant и concerns — данные о здоровье, специальная категория
/// ПДн. sessionId читать ТОЛЬКО из подписанной httpOnly-cookie, никогда из
/// query или тела запроса, иначе чужая анкета открывается подбором строки.
model SkinSurvey {
  id               String    @id @default(uuid())
  userId           String?
  sessionId        String
  skinType         SkinType?
  concerns         Concern[]
  ageRange         String?
  isPregnant       Boolean? // противопоказания: ретинол, кислоты
  notes            String?
  resultProductIds String[]
  createdAt        DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("skin_surveys")
}

/// Заявка на консультацию косметолога — вторая плашка на главной.
model ConsultationRequest {
  id        String             @id @default(uuid())
  userId    String?
  name      String
  phone     String
  email     String?
  channel   String? // phone | telegram | vk
  message   String?
  status    ConsultationStatus @default(new)
  adminNote String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@map("consultation_requests")
}
